{
  "expo": {
    "name": "my-chinese-pet",
    "slug": "my-chinese-pet",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mychinesepet",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.mychinesepet"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dbcfe450-d38d-48da-b9f5-dc46d6065b0b"
      }
    }
  }
}
